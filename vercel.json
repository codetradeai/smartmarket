{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/((?!assets/)[^.]*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://BACKEND-SMARTMARKET-URL-AQUI/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
