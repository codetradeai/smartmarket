# Copie para .env e preencha. O .env NAO vai para o git (ver .gitignore).
#   cp .env.example .env

# Senha do PostgreSQL. Usada pelo banco e pelo backend no docker-compose.
POSTGRES_PASSWORD=troque-esta-senha

# Segredo de assinatura do JWT (HS256). Precisa de no minimo 32 bytes.
# Gere um valor novo e unico por ambiente:
#   openssl rand -base64 48
#
# ATENCAO: o segredo que ficou commitado neste repositorio ate 01/11/2026
# deve ser considerado comprometido para sempre — ele esta no historico do
# git. Qualquer ambiente que ainda o utilize precisa de rotacao.
SMARTMARKET_JWT_SECRET=gere-um-segredo-novo-com-openssl-rand-base64-48

# Opcional: origens liberadas no CORS (separadas por virgula).
# SMARTMARKET_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
